# -------------------------------------------------
# Neon Postgres
# Create a project at https://neon.tech -> Connection string (use the pooled one)
# Then run: pnpm db:migrate
# -------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------
# Better Auth
# Secret: openssl rand -hex 32   URL: your public app URL
# Google sign-in is optional (leave empty to hide the button)
# -------------------------------------------------
BETTER_AUTH_SECRET=replace-with-32-byte-hex
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------
# Google AI (Gemini)
# Get a key at https://aistudio.google.com/app/apikey
# Used for all AI generation: course metadata, lesson gen, exam questions
# -------------------------------------------------
GOOGLE_API_KEY=your-google-ai-api-key

# -------------------------------------------------
# App URL
# Used internally for server-to-server API calls
# Dev: http://localhost:3000   Prod: https://your-domain.com
# -------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -------------------------------------------------
# Vercel Blob
# Auto-injected by Vercel in production.
# For local dev: run `npx vercel env pull` or copy the token from
# Vercel dashboard -> Storage -> your Blob store -> .env.local
# -------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Gemini model to use for AI generation.
# Find available models and their IDs at https://aistudio.google.com/app/, and copy one of the model names listed there.
MODEL=gemini-3-flash-preview

